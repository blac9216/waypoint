<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    ADR-0013/0014, issue #440: the compliance-runner Generic Host. This is a
    composition root, not a new implementation: it references Waypoint.Infrastructure
    (which already carries the discover/credential-test/scan handlers, the PowerShell
    runspace pool, and the envelope-encryption secret stores from M2) and
    Waypoint.Runner (the shared dispatcher/lease/event mechanics from #457) and narrows
    the job-type allowlist to JobCapabilities.Compliance. It must never reference
    Waypoint.Api or host ASP.NET/REST/SSE (ADR-0013 P1); ASP.NET Core's own
    "Worker" SDK (no Sdk.Web) enforces that at the project-template level.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Waypoint.ComplianceRunner</RootNamespace>
    <UserSecretsId>dotnet-Waypoint.ComplianceRunner</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Waypoint.Core\Waypoint.Core.csproj" />
    <ProjectReference Include="..\Waypoint.Runner\Waypoint.Runner.csproj" />
    <ProjectReference Include="..\Waypoint.Infrastructure\Waypoint.Infrastructure.csproj" />
  </ItemGroup>


</Project>
