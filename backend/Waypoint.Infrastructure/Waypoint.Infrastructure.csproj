<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Waypoint.Core\Waypoint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <!-- Plain Npgsql, not an ORM: the job queue's SELECT ... FOR UPDATE SKIP LOCKED
         (ADR-0008) is raw SQL by nature, and the migrations pipeline (issue #4) is a
         small hand-rolled runner over embedded .sql files rather than EF Core's
         generated-migration model, so there is no EF Core dependency to add here. -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <!-- Lets JobQueueClaimSqlParityTests read JobQueueRepository.ClaimSql directly. The
       alternative is a test that restates the SQL it is supposed to be checking, which
       is the "test that cannot fail" pattern this repo has already shipped three times:
       a copy agrees with itself no matter how far the original drifts. Matches the
       pattern Waypoint.Api.csproj already uses for its own internals. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Waypoint.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
