<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Issue #443 (ADR-0013 §1): this project is now control-plane only: repositories,
    migrations, secrets/crypto, SSE feed/replay, and the run-secret lifecycle. It
    deliberately does NOT reference Microsoft.PowerShell.SDK or any dispatcher/
    lease-recovery/PowerShell-host type: those, plus every PowerShell-backed
    IJobHandler, moved to the sibling Waypoint.Infrastructure.Execution project that
    only the two dedicated runner executables reference. Waypoint.Api references only
    this project, never Waypoint.Infrastructure.Execution; that missing reference is
    what makes "the API process cannot execute a job" a build-time fact instead of a
    runtime configuration choice. The Waypoint.Runner reference below is narrower than
    it looks: this project uses exactly one type from it, JobEventPublisher (the
    job_events row writer both the control-plane enqueue/cancel path and the runner
    dispatcher share); Waypoint.Runner itself carries no PowerShell dependency (see
    its own csproj), so this reference does not reintroduce an execution capability.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Waypoint.Core\Waypoint.Core.csproj" />
    <ProjectReference Include="..\Waypoint.Runner\Waypoint.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <!-- Issue #310: IHttpClientFactory for the STIG Manager reachability probe
         (HttpStigManagerProbe), the only outbound HTTP client this layer needs. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <!-- Plain Npgsql, not an ORM: the job queue's SELECT ... FOR UPDATE SKIP LOCKED
         (ADR-0008) is raw SQL by nature, and the migrations pipeline (issue #4) is a
         small hand-rolled runner over embedded .sql files rather than EF Core's
         generated-migration model, so there is no EF Core dependency to add here. -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <!-- Lets JobQueueClaimSqlParityTests read JobQueueRepository.ClaimSql directly. The
       alternative is a test that restates the SQL it is supposed to be checking, which
       is the "test that cannot fail" pattern this repo has already shipped three times:
       a copy agrees with itself no matter how far the original drifts. Matches the
       pattern Waypoint.Api.csproj already uses for its own internals. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Waypoint.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
