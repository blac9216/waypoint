<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Waypoint.Core\Waypoint.Core.csproj" />
    <ProjectReference Include="..\Waypoint.Infrastructure\Waypoint.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Lets the test project assert on helpers that are deliberately not public API:
       health-probe URL resolution and validation-detail formatting. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Waypoint.Tests" />
  </ItemGroup>

  <!-- #192: appsettings.Testing.json carries ForwardedHeaders:TrustAnyProxy=true, which
       Program.cs only honours when ASPNETCORE_ENVIRONMENT=Testing. Publishing the file
       into the runtime image would let an operator arm that trust-everyone bypass in
       production with nothing but an env var. CopyToPublishDirectory=Never keeps it out
       of `dotnet publish` output (and therefore the Docker image) while leaving
       CopyToOutputDirectory untouched, so `dotnet build`/`dotnet test` still copy it to
       bin/ and WaypointApiFactory (UseEnvironment("Testing")) still loads it from the
       content root. -->
  <ItemGroup>
    <Content Update="appsettings.Testing.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
