<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="8.0.11" />
    <!-- YAML validation for config-doc saves (issue #265): MIT-licensed, see NOTICE. -->
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

  <!-- Issue #1437: shipped preset resolver data (component tool-family classification,
       per-generation SKU-family membership), loaded via PresetDataCatalog. -->
  <ItemGroup>
    <EmbeddedResource Include="Subscriptions\Presets\PresetData\componentCatalog.json" />
    <EmbeddedResource Include="Subscriptions\Presets\PresetData\Generations\*.json" />
  </ItemGroup>

</Project>
